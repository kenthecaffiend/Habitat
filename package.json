    "heic-decode": "2.1.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
